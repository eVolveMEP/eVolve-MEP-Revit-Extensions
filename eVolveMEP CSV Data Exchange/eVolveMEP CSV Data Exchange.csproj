<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>eVolve CSV Data Exchange</Title>
		<Company>eVolve MEP, LLC</Company>
		<Product>eVolve Revit Extensions</Product>
		<Description>CSV file importer/exporter for use with the eVolve Revit product line.</Description>
		<Copyright>Copyright © 2026 eVolve MEP, LLC</Copyright>
		<Version>10.0.0.06016</Version>
		<Configurations>
			eE Debug Revit 2024;
			eE Debug Revit 2025;
			eE Debug Revit 2026;
			eE Debug Revit 2027;

			eE Release Revit 2024;
			eE Release Revit 2025;
			eE Release Revit 2026;
			eE Release Revit 2027;

			eM Debug Revit 2024;
			eM Debug Revit 2025;
			eM Debug Revit 2026;
			eM Debug Revit 2027;

			eM Release Revit 2024;
			eM Release Revit 2025;
			eM Release Revit 2026;
			eM Release Revit 2027;
		</Configurations>
	</PropertyGroup>
	
	<PropertyGroup>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
		<Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
		<ProjectGuid>{8D6F812D-459D-4931-BD54-CEBAA484EDE8}</ProjectGuid>
		<OutputType>Library</OutputType>
		<AppDesignerFolder>Properties</AppDesignerFolder>
		<RootNamespace>eVolve.CsvDataExchange.Revit</RootNamespace>
		<AssemblyName>eVolveCSVDataExchange-UpdateInConditionalProperties</AssemblyName>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
	</PropertyGroup>
	
	<Import Project="../ConditionalTargets/SharedProjectSettings.targets" />
	<Import Project="../ConditionalTargets/Revit/Revit2024.targets" Condition="$(DefineConstants.Contains('REVIT2024'))" />
	<Import Project="../ConditionalTargets/Revit/Revit2025.targets" Condition="$(DefineConstants.Contains('REVIT2025'))" />
	<Import Project="../ConditionalTargets/Revit/Revit2026.targets" Condition="$(DefineConstants.Contains('REVIT2026'))" />
	<Import Project="../ConditionalTargets/Revit/Revit2027.targets" Condition="$(DefineConstants.Contains('REVIT2027'))" />
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<AssemblyName>eVolveCSVDataExchange-eVolve$(EvolveProduct)</AssemblyName>
		<DocumentationFile>bin\Debug Revit $(RevitYear)\eVolveCSVDataExchange.xml</DocumentationFile>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('Release'))">
		<AssemblyName>eVolveCSVDataExchange-eVolve$(EvolveProduct)</AssemblyName>
	</PropertyGroup>
	
	<ItemGroup>
		<Reference Include="eVolve$(EvolveProduct)">
			<HintPath>..\..\eVolve-Revit-Products\eVolve $(EvolveProduct)\bin\Release\eVolve$(EvolveProduct).dll</HintPath>
			<Private>False</Private>
			<Aliases>eVolveProduct</Aliases>
		</Reference>
	</ItemGroup>
	
	<ItemGroup Condition="!$(DefineConstants.Contains('CORE'))">
		<Reference Include="PresentationCore" />
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="System.Xml" />
		<Reference Include="WindowsBase" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
	</ItemGroup>
	
	<ItemGroup>
		<Compile Include="..\Common\CommandAvailablity.cs">
			<Link>CommandAvailablity.cs</Link>
		</Compile>
		<Compile Include="..\Common\Methods.cs">
			<Link>Methods.cs</Link>
		</Compile>
		<Compile Include="Command.cs" />
		<Compile Include="Application.cs" />
		<Compile Include="ConfigurationForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Include="ConfigurationForm.Designer.cs">
			<DependentUpon>ConfigurationForm.cs</DependentUpon>
		</Compile>
		<Compile Include="GlobalUsings.cs" />
		<Compile Include="Properties\Resources.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Include="Settings.cs" />
	</ItemGroup>
	
	<ItemGroup>
		<EmbeddedResource Include="ConfigurationForm.resx">
			<DependentUpon>ConfigurationForm.cs</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Include="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
	
	<ItemGroup>
		<None Include="LinkedVideo_20x20.png" />
		<None Include="packages.config" />
		<None Include="_CSVDataExchange.addin">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<EmbeddedResource Include="CSV_ImportExport_32x32.png" />
		<None Include="Help_Medium_20x20.png" />
		<None Include="Settings_20x20.png" />
		<None Include="Resources\Logo.png" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="CALL &quot;$(SolutionDir)BuildTools\PostBuild.bat&quot; &quot;$(ConfigurationName)&quot; &quot;$(TargetDir)&quot; &quot;$(TargetPath)&quot; &quot;A70A6A1A-BF91-C541-158A-5589D57891CB&quot; &quot;9F07922B-CCDF-2290-C059-CC7A8F1FFC78&quot;" />
	</Target>
</Project>